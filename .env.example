# Backend only. Never put credentials in VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ENVIRONMENT=development
# JSON array of exact browser origins; production: your assigned Vercel origin.
SENTINEL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional. Unset by default; no industry or synthetic acceptance limit is defined.
# SENTINEL_CONVENTIONAL_24H_LIMIT_UA=
