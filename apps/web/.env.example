# Default: browser uses same-origin requests through the Vite proxy.
VITE_API_BASE_URL=
# On Vercel, set this to the assigned Render HTTPS origin, without /api/v1.
# Example only: VITE_API_BASE_URL=https://your-sentinel-api.onrender.com
# This is public build-time configuration. Never add Gemini credentials here.
# FastAPI target for the development/preview proxy (no trailing path).
API_PROXY_TARGET=http://127.0.0.1:8000
